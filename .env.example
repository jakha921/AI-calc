# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customs_calc
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/customs_calc

# App settings
APP_NAME=Customs Calculator
